# =============================================================================
# Unipod WhatsApp bot — environment
# Copy to .env and fill values. Never commit .env or data/session.db.
#
# Required NOW: WHATSAPP_SESSION_PATH, ADMIN_PHONES
# Optional NOW: TEST_GROUP_JID (limit question/@ routing + admin notify), DEBUG, LOG_LEVEL
# Step 5 Graphiti retrieval + ingest needs GROQ_API_KEY + OPENAI_API_KEY + FalkorDB.
# GRAPHITI_ENABLED=false keeps WhatsApp/Groq running if FalkorDB is down.
# =============================================================================

# --- WhatsApp session --------------------------------------------------------
# SQLite file created on first QR pair. On Docker this is overridden to
# /app/data/session.db. Keep the file private; it is the linked device.
WHATSAPP_SESSION_PATH=data/session.db

# --- Groups ------------------------------------------------------------------
# Ingest/logging: ALL groups the bot is a member of.
# Replies / unknown-question admin DMs (step 2+): only this group when set.
# Leave empty until you have seen a group= line after pairing.
TEST_GROUP_JID=

# Shared Graphiti partition. Use underscore — Graphiti rejects ':'.
GRAPHITI_GROUP_ID=unipod_innovators

# --- Admins (allowlist in code, not the LLM) ---------------------------------
# International digits only: no +, spaces, or dashes.
# Multiple admins: comma-separated. ADMIN_PHONE is merged if set.
# Example: 2348012345678,2348098765432
ADMIN_PHONES=
ADMIN_PHONE=
# Optional extra JIDs if a number is LID-only (step 2+). Comma-separated.
# Example: 2348012345678@s.whatsapp.net
ADMIN_JIDS=

# --- Logging -----------------------------------------------------------------
# INFO for production. DEBUG=true forces DEBUG logs (skip reasons, file:line).
LOG_LEVEL=INFO
# Set true while pairing or reviewing logs with a developer. false in quiet production.
DEBUG=true
# Worker heartbeat interval in seconds (logged as event=heartbeat).
HEARTBEAT_SECONDS=60

# --- Groq (step 3+ replies + Graphiti extraction). Empty = no LLM replies. ---
# Supports multiple comma-separated API keys for round-robin rotation.
# Each key's daily token limit is independent, so N keys ≈ N × 200k TPD.
# Example: GROQ_API_KEY=gsk_key1,gsk_key2,gsk_key3
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45

# --- OpenAI (step 4 Graphiti embeddings/rerank only; replies stay on Groq) ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# true = start Graphiti ingest + retrieval when both API keys are set.
GRAPHITI_ENABLED=true

# Graphiti ingest concurrency (lower on 2 GB RAM).
SEMAPHORE_LIMIT=2
RETRIEVAL_MIN_FACTS=1
# Drop Graphiti cross-encoder hits below this score (0 keeps all ranked hits).
RETRIEVAL_MIN_SCORE=0
GRAPHITI_SEARCH_TIMEOUT_SECONDS=20
SHORT_TERM_MAX_MESSAGES=50
QUEUE_MAXSIZE=1000

# --- Feedback contacts (for unverified info redirect) -----------------------
# When the bot cites info from a non-admin source, it directs users to these
# contacts for verification. Format: phone:DisplayName,phone:DisplayName
# Example: 254102838378:Diane,254142340147:Ayuen
FEEDBACK_CONTACTS=

# --- Topic helpers (domain-specific referrals) --------------------------------
# Map question topics to dedicated contacts so the bot can refer members to the
# right person when a question clearly belongs to a domain.
# Format: topic:phone:DisplayName,topic:phone:DisplayName
# Topics are arbitrary lowercase labels — match them to your community roles.
# Example: bot:254102838378:Admin,programs:254142340147:Ayuen,events:254142340147:Ayuen
HELPERS_CONFIG=

# --- Fact-correction strictness -----------------------------------------------
# Minimum number of independent Graphiti facts required before the bot will
# attempt to correct a user's statement. Higher = more conservative.
RETRIEVAL_MIN_CORRECTION_FACTS=2

# --- Health checks & daily reports -------------------------------------------
# How often (seconds) to run backend health checks (FalkorDB, Groq, queues).
HEALTH_CHECK_INTERVAL_SECONDS=300
# Seconds to wait after startup before running the first health check.
# Gives backends time to stabilise; avoids false alerts on restart.
HEALTH_CHECK_INITIAL_DELAY_SECONDS=120
# Fixed UTC time (HH:MM or HH) at which the daily activity report is sent to admins.
# Example: 18:00 (which is 21:00 EAT / Nairobi time), or 20:00.
DAILY_REPORT_TIME=18:00
# Alternatively set hour and minute individually (UTC):
DAILY_REPORT_HOUR_UTC=18
DAILY_REPORT_MINUTE_UTC=0
# Minimum seconds between repeated critical alerts of the same type.
CRITICAL_ALERT_COOLDOWN_SECONDS=600

# --- PDF ingestion -----------------------------------------------------------
# Set to false to disable PDF text extraction and Graphiti ingestion.
PDF_INGESTION_ENABLED=true

# --- FalkorDB (step 4). Local uv run: localhost. Compose bot: host "falkordb".
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# GRAPHITI_GROUP_ID is also the FalkorDB graph name. Leave blank to use that id.
# Do not set this to default_db unless that is also GRAPHITI_GROUP_ID.
FALKORDB_DATABASE=
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# --- Piper TTS (Voice Notes) --------------------------------------------------
# Optional: Set to true and provide URL for self-hosted Piper TTS server.
TTS_ENABLED=true
PIPER_TTS_URL=
PIPER_TTS_API_KEY=
PIPER_TTS_VOICE=en_US-lessac-medium
TTS_TIMEOUT_SECONDS=30

# --- TTS Audio Caching (SHA-256) ---------------------------------------------
# Caches synthesized audio by SHA-256(voice + text) on disk to eliminate CPU
# spikes and latency on repeated phrases/questions (critical for T4g ARM64).
TTS_CACHE_ENABLED=true
TTS_CACHE_DIR=data/tts_cache
TTS_CACHE_MAX_FILES=1000

